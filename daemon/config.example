# Clawdmeter daemon config
#
# Copy this file to:
#   macOS / Linux : ~/.config/claude-usage-monitor/config
#   Windows       : %LOCALAPPDATA%\Clawdmeter\config
#
# The daemon re-reads it on every poll, so edits take effect within ~60s — no restart needed.

# Poll more than one Claude config dir and show whichever plan is currently
# active. Use this if you run separate plans from different config dirs (e.g. a
# personal plan in ~/.claude and a work plan in ~/.claude-work, selected via
# CLAUDE_CONFIG_DIR). Comma-separated; ~ is expanded.
#   - The daemon polls every listed dir each cycle and displays the plan whose
#     usage rose most recently (i.e. the one you're actively using). Before any
#     change is seen it shows the plan with the highest current usage.
#   - Unset (default) = just ~/.claude, unchanged single-plan behavior.
#   - install.sh can detect your ~/.claude* dirs and fill this in for you.
# config_dirs = ~/.claude, ~/.claude-work

# Seconds between Anthropic API polls (Linux daemon). Default 60. Minimum 10.
# The firmware marks data older than 90s as stale and only updates its "resets
# in" countdown when a payload lands, so anything above ~80 relies on the
# heartbeat below to keep the display live.
# poll_interval = 60

# Seconds between heartbeat replays of the last payload while waiting for the
# next API poll (Linux daemon). The replay ages the reset countdowns and clock
# so the display stays accurate without an API call. Default 60. Minimum 10.
# Set it >= poll_interval to disable.
# heartbeat_interval = 60

# Play a sound on the device when your 5-hour session limit resets, so you know
# you can use Claude again without watching the screen.
#   off = silent (default)
#   on  = chime through the board speaker (boards with audio: AMOLED-2.16 / 1.8)
chime = off
# Show a clock on the Usage screen, in place of the "Usage" title.
#   off  = no clock; the screen keeps showing "Usage" (default)
#   auto = show the clock, auto-detecting 12h/24h from this machine's settings
#          (detection can default to 24h when the daemon runs under launchd/systemd
#           with no locale — set 12 or 24 explicitly below if auto guesses wrong)
#   12   = show the clock, forced 12-hour  (e.g. 6:28 PM)
#   24   = show the clock, forced 24-hour  (e.g. 18:28)
clock = off

# Which board this machine should drive, when several are paired with it
# (Windows only). Each board advertises its own suffix — "Clawdmeter F629" —
# and that suffix, or the full address, is what goes here:
#   device = F629
#   device = 28:84:85:4B:F6:29
# Unset (default) = whichever paired board answers first. The daemon tries the
# named one first and falls back to the others if it does not respond, so a
# board that is switched off or out of range never blocks the rest.
# device =

# Show on the device what Claude Code is doing — thinking, writing, waiting for
# your permission, done, out of quota (macOS daemon). Needs the Claude Code
# hooks, installed once with:
#   daemon/.venv/bin/python daemon/clawd_activity.py --install
# and the csb-buddy firmware, which knows the animations and the fields.
#   off = the device picks its own animations by usage rate (default)
#   on  = the device mirrors Claude Code's state
# activity = on
# activity, screen_mode and corner_buddy take effect within a second, not at
# the next poll.
# What the device shows while activity is on:
#   usage = the numbers; the corner buddy and footer still follow Claude
#   clawd = the big animation all the time
#   auto  = the numbers, switching to the animation for a few seconds whenever
#           Claude's state changes (default)
# screen_mode = auto
# Animate the small buddy in the usage screen's corner (on, default) or not.
# corner_buddy = on
